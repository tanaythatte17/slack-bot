# Postgres connection used by the app at runtime (pooled, e.g. Supabase pooler)
DATABASE_URL=

# Direct (non-pooled) Postgres connection, used by Prisma Migrate
DIRECT_URL=

# Base URL of the frontend, used for CORS and post-OAuth redirects
FRONTEND_URL=http://localhost:5173

# Port the API listens on
PORT=3000

NODE_ENV=development

# Secret used to sign session JWTs
JWT_SECRET=

# Base64-encoded 32-byte key used to encrypt Slack/Notion tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must match TOKEN_ENCRYPTION_KEY in serverFlow/.env.
TOKEN_ENCRYPTION_KEY=

# Slack app credentials (OpenID login) — https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/auth/slack/callback

# Same Slack app's bot install redirect (scopes: app_mentions:read, channels:history, chat:write, im:history)
SLACK_BOT_REDIRECT_URI=http://localhost:3000/auth/slack/bot/callback

# Notion integration credentials — https://www.notion.so/my-integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/auth/notion/callback

# Google Gemini API key, used for embeddings during indexing
GEMINI_API_KEY=
