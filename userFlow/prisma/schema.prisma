generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  extensions = ["pgvector"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String            @id @default(uuid()) @db.Uuid
  slack_id    String            @unique
  email       String            @unique
  name        String?
  avatar      String?
  created_at  DateTime          @default(now())
  memberships WorkspaceMember[]
}

model WorkspaceMember {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  workspace_id String
  role         String    @default("member")
  created_at   DateTime  @default(now())
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([user_id, workspace_id])
}

model Workspace {
  id                   String            @id
  team_name            String?
  slack_bot_token      String
  slack_bot_user_id    String?
  notion_token         String?
  notion_workspace_id  String?
  plan                 Plan              @default(trial)
  trial_ends_at        DateTime?         @default(dbgenerated("(now() + '14 days'::interval)"))
  active               Boolean           @default(true)
  created_at           DateTime          @default(now())
  notion_refresh_token String?
  billing              Billing?
  document_chunks      DocumentChunk[]
  sync_jobs            SyncJob[]
  members              WorkspaceMember[]

  @@index([plan])
  @@index([trial_ends_at], map: "idx_workspaces_trial")
}

model DocumentChunk {
  id               String   @id @default(uuid()) @db.Uuid
  workspace_id     String

  source_notion_id String
  source_url       String?
  source_title     String?

  notion_block_id  String @unique
  heading_path     Json?
  content_hash     String

  content          String
  chunk_index      Int      @default(0)

  created_at       DateTime @default(now())
  embedding        Unsupported("vector(3072)")

  workspace        Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@index([source_notion_id])
  @@index([notion_block_id])
}

model SyncJob {
  id             String     @id @default(uuid()) @db.Uuid
  workspace_id   String
  status         SyncStatus @default(pending)
  pages_found    Int?
  chunks_indexed Int?
  error_message  String?
  started_at     DateTime?
  completed_at   DateTime?
  created_at     DateTime   @default(now())
  workspace      Workspace  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
}

model Billing {
  workspace_id          String    @id
  polar_customer_id     String?
  polar_subscription_id String?
  plan_name             String?
  current_period_end    DateTime?
  canceled_at           DateTime?
  updated_at            DateTime  @default(now())
  workspace             Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
}

model OAuthState {
  state       String   @id
  userId      String
  workspaceId String
  created_at  DateTime @default(now())
}

model NotionPage {
  id String @id

  workspace_id String

  title String
  page_hash String

  last_synced_at DateTime @updatedAt
}

enum Plan {
  trial
  starter
  growth
  team
  expired
}

enum SyncStatus {
  pending
  running
  complete
  failed
}
