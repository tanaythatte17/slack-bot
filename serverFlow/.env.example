# Same Postgres database as userFlow — serverFlow reads Workspace tokens
# and indexed DocumentChunk rows from it.
DATABASE_URL=

# Slack app's signing secret, used to verify incoming Slack requests.
# Per-workspace bot tokens are read from the DB (set by userFlow's Slack
# install flow), not from env.
SLACK_SIGNING_SECRET=

# Base64-encoded 32-byte key used to decrypt Slack/Notion tokens stored by
# userFlow. Must be the exact same value as TOKEN_ENCRYPTION_KEY in
# userFlow/.env.
TOKEN_ENCRYPTION_KEY=

# Google Gemini API key, used for query embedding + answer generation
GEMINI_API_KEY=

# Cohere API key, used to rerank retrieved chunks before answering
COHERE_API_KEY=
